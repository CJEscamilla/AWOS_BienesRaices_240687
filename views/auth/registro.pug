extends ../layout/index

block contenido
  div
    h2.text-center.text-2xl.font-extrabold.text-orange-600 Bienes
    span.font-normal.text-black Raices

    h2.text-center.text-2x1.font-normal.text-black Por favor ingresa cuidadosamente tus datos

    .mt-8.mx-auto.max-w-x1
    .bg-white.py-8.px-4.shadow-2x1.round-2x1 
        form.space-y-5
        div.px-5 
            label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="nombreUsuario") nombrecompleto:
            input#nombreUsuario(type="text" class="hover:inset-shadow-sm focus:inset-shadown-x1 focus:inset-shadown-orange-300 focus:outline-none" 
            placeholder="p.e.: Cristopher Joseph Escamilla Vargas"
            name= "usuarioNombre").w-full.hover.border
            .border-gray-300.px-3.py-2.round-x1.placeholder-gray-400 

        div.px-5 
            label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="emailUsuario") correoelectronico:
            input#nombreUsuario(type="text" class="hover:inset-shadow-sm focus:inset-shadown-x1 focus:inset-shadown-orange-300 focus:outline-none" 
            placeholder="p.e.: Cristopher@dd.com"
            name= "emailNombre").w-full.hover.border
            .border-gray-300.px-3.py-2.round-x1.placeholder-gray-400 
        
        div.px-5 
            label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="passwordUsuario") Contraseña:
            input#nombreUsuario(type="text" class="hover:inset-shadow-sm focus:inset-shadown-x1 focus:inset-shadown-orange-300 focus:outline-none" 
            placeholder="Por lo menos 8 carácteres"
            name= "emailNombr").w-full.hover.border
            .border-gray-300.px-3.py-2.round-x1.placeholder-gray-400 

        div.px-5
        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="confirmacionUsuario") Confirmación de Contraseña:
        input#confirmacionUsuario.w-full.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400(placeholder= "Repite la contraseña anterior" name="confirmacionUsuario" type="password")


input(class="w-full bg-gray-300 text-orange-400 hover:bg-orange-400 hover:text-white font-bold py-3 cursor-pointer rounded-4xl shadow-lg uppercase" type="submit" 
value="Registrar Usuario") 
div.flex.items-center.justify-between.pt-3
                a(  class="text-gray-500 text-sm hover:decoration-orange-400 hover:underline transition decoration-2" href="/auth/login") ¿Ya tienes cuenta? Inicia Sesión
                a(  class="text-gray-500 text-sm hover:decoration-orange-400 hover:underline transition decoration-2"  href="") ¿Olvidaste tu contraseña? Recuperala

            





            