doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Mi Página con Pug
    link(rel="stylesheet", href="style.css")
  
  body
    header
      h1 Bienvenido a mi sitio web
      nav
        ul
          li: a(href="#home") Inicio
          li: a(href="#about") Nosotros
          li: a(href="#contact") Contacto

    main
      section#hero
        h2 Construyendo con elegancia
        p Este HTML fue generado usando un motor de plantillas.
        
        //- Ejemplo de una variable y un condicional
        - const usuarioLogueado = true
        if usuarioLogueado
          button.btn Entrar al Panel
        else
          button.btn Registrarse

      section#features
        h3 Características principales
        ul
          //- Ejemplo de un bucle (iteración)
          each item in ['Rápido', 'Limpio', 'Potente']
            li= item

    footer
      p &copy; 2026 Mi Proyecto - Hecho con Pug